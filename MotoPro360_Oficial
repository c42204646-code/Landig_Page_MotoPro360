  <script>
    lucide.createIcons();

    function switchTab(tab) {
      const vMoteros = document.getElementById('viewMoteros');
      const vComercios = document.getElementById('viewComercios');
      const vFlotas = document.getElementById('viewFlotas');
      const bMoteros = document.getElementById('btnTabMoteros');
      const bComercios = document.getElementById('btnTabComercios');
      const bFlotas = document.getElementById('btnTabFlotas');

      const activeClass = 'py-3 px-4 rounded-xl font-display font-bold text-xs uppercase tracking-wider matte-red-btn text-white shadow transition flex items-center justify-center';
      const inactiveClass = 'py-3 px-4 rounded-xl font-display font-bold text-xs uppercase tracking-wider text-slate-700 hover:text-slate-900 transition flex items-center justify-center';

      vMoteros.classList.add('hidden');
      vComercios.classList.add('hidden');
      vFlotas.classList.add('hidden');
      bMoteros.className = inactiveClass;
      bComercios.className = inactiveClass;
      bFlotas.className = inactiveClass;

      if (tab === 'moteros') {
        vMoteros.classList.remove('hidden');
        bMoteros.className = activeClass;
      } else if (tab === 'comercios') {
        vComercios.classList.remove('hidden');
        bComercios.className = activeClass;
      } else {
        vFlotas.classList.remove('hidden');
        bFlotas.className = activeClass;
      }
    }

    function goToPlans(tab) {
      switchTab(tab);
      document.getElementById('planes').scrollIntoView({ behavior: 'smooth' });
    }

    function updateDemoAlert() {
      const moto = document.getElementById('demoMoto').value;
      const promo = document.getElementById('demoPromo').value;
      document.getElementById('demoResultMoto').textContent = `Especial para tu ${moto}:`;
      document.getElementById('demoResultPromo').textContent = `"${promo}"`;
    }

    function openAffiliation(type, plan) {
      document.getElementById('modalAfiliacion').classList.remove('hidden');
      document.getElementById('modalTypeTag').textContent = `Afiliación de ${type}`;
      document.getElementById('modalPlanName').textContent = `Plan elegido: ${plan}`;
      const extraLabel = document.getElementById('formExtraLabel');
      const extraInput = document.getElementById('formExtra');

      if (type === 'Comercio') {
        extraLabel.textContent = 'Rubro y Ubicación del Comercio en Caracas';
        extraInput.placeholder = 'Ej. Venta de Repuestos en Chacao / Taller en Catia';
      } else {
        extraLabel.textContent = 'Marca, Modelo y Cilindrada de tu Moto';
        extraInput.placeholder = 'Ej. Empire Horse 150cc / Bera SBR 150cc';
      }
    }

    function closeAffiliation() {
      document.getElementById('modalAfiliacion').classList.add('hidden');
    }

    function sendAffiliation(e) {
      e.preventDefault();
      const name = document.getElementById('formName').value;
      const plan = document.getElementById('modalPlanName').textContent;
      const toast = document.getElementById('toastConfirmacion');
      document.getElementById('toastConfirmText').textContent = `¡Excelente, ${name}! Registramos tu solicitud (${plan}). Te contactaremos al 04162009214 o vía motoopro360@gmail.com para completar tu activación.`;
      closeAffiliation();
      e.target.reset();
      toast.classList.remove('hidden');
      setTimeout(() => toast.classList.add('hidden'), 6000);
    }
  </script>
